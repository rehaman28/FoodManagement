      "name": "01 - User Management",
      "item": [
        {
          "name": "Create User - Happy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{testBaseUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"Postman User {{$timestamp}}\",\n  \"userPhone\": \"9876543210\",\n  \"email\": \"postman{{$timestamp}}@example.com\",\n  \"password\": \"Postman@123\",\n  \"userAddresses\": [\n    {\n      \"doorNumber\": \"12-3\",\n      \"street\": \"MG Road\",\n      \"city\": \"Hyderabad\",\n      \"district\": \"Hyderabad\",\n      \"country\": \"India\",\n      \"pincode\": \"500001\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 201\",()=>pm.response.to.have.status(201));",
                  "pm.test(\"Response status matches expected\",()=>pm.expect(pm.response.code).to.eql(201));",
                  "const r=pm.response.json(); if(r.userId!==undefined) pm.environment.set(\"userId\", r.userId);"
                ]
              }
            }
          ]
        },
