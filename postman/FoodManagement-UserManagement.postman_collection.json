        {
          "name": "[RBAC] Get All Users - USER 403 / ADMIN 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{userServiceUrl}}/users"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "type": "string",
                  "value": "{{TOKEN}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TOKEN is present\",()=>pm.expect(pm.environment.get(\"TOKEN\")).to.be.a(\"string\").and.not.empty);",
                  "const role = pm.environment.get(\"role\");",
                  "pm.test(\"RBAC status is correct for active role\",()=>{",
                  "  const expected = role === \"USER\" ? 403 : 200;",
                  "  pm.expect(pm.response.code).to.eql(expected);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
