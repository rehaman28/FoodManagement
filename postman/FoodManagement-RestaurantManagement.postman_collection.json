                  "type": "string",
                  "value": "{{TOKEN}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 201\",()=>pm.response.to.have.status(201));",
                  "pm.test(\"Response status matches expected\",()=>pm.expect(pm.response.code).to.eql(201));",
                  "const r=pm.response.json(); if(r.Id!==undefined) pm.environment.set(\"restaurantId\", r.Id);"
