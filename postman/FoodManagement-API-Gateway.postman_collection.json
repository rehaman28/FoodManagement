                {
                  "key": "token",
                  "type": "string",
                  "value": "{{TOKEN}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const role=pm.environment.get(\"role\");",
                  "const expected=role===\"USER\"?403:200;",
                  "pm.test(\"Downstream USER/ADMIN RBAC is preserved\",()=>pm.expect(pm.response.code).to.eql(expected));"
                ]
              }
            }
          ]
        },
        {
          "name": "Order Route - RBAC Through Gateway",
          "request": {
            "method": "GET",
            "header": [
