          "name": "Restaurant Route - Get All Restaurants",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{testBaseUrl}}/restaurants",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "type": "string",
                  "value": "{{TOKEN}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Restaurant route returns 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"Gateway route returned a response\",()=>pm.expect(pm.response.code).to.eql(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "User Route - RBAC Through Gateway",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{testBaseUrl}}/users",
            "auth": {
              "type": "bearer",
