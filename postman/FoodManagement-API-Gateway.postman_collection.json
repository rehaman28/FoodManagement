{
  "info": {
    "_postman_id": "d0bb1c0a-9f4c-4f27-8c40-11a2e8b4d901",
    "name": "FoodManagement - API Gateway Regression",
    "description": "API Gateway regression. Requests use {{testBaseUrl}} so the same canonical test endpoint is used across all Postman collections.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gatewayBaseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "TOKEN",
      "value": ""
    },
    {
      "key": "testBaseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "00 - Gateway Authentication",
      "item": [
        {
          "name": "Login - Through Gateway",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{testBaseUrl}}/auth/login",
              "host": [
                "{{testBaseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\",()=>pm.response.to.have.status(200));",
                  "const body=pm.response.json();",
                  "pm.test(\"Login response contains token\",()=>pm.expect(body.token).to.be.a(\"string\").and.not.empty);",
                  "pm.environment.set(\"TOKEN\",body.token);",
                  "const parts=body.token.split(\".\");",
                  "pm.test(\"JWT has 3 segments\",()=>pm.expect(parts.length).to.eql(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "Protected Route - No Token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{testBaseUrl}}/restaurants"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Gateway returns 401 without token\",()=>pm.response.to.have.status(401));",
                  "pm.test(\"Response status matches expected\",()=>pm.expect(pm.response.code).to.eql(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Protected Route - Invalid JWT",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "type": "string",
                  "value": "invalid.jwt.token"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{testBaseUrl}}/restaurants"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Gateway returns 401 for invalid JWT\",()=>pm.response.to.have.status(401));",
                  "pm.test(\"Response status matches expected\",()=>pm.expect(pm.response.code).to.eql(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Gateway Routing",
      "item": [
