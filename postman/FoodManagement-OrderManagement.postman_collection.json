      "item": [
        {
          "name": "Place Order - Happy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{orderServiceUrl}}/orders/placeorder",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"OrderingItems\": [\n    {\n      \"quantity\": 1,\n      \"itemId\": \"{{itemId}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 201\",()=>pm.response.to.have.status(201));",
                  "pm.test(\"Response status matches expected\",()=>pm.expect(pm.response.code).to.eql(201));",
                  "const r=pm.response.json(); if(r.orderId!==undefined) pm.environment.set(\"orderId\", r.orderId);"
                ]
              }
            }
          ]
        },
